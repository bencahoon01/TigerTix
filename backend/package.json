{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.9.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "admin-service/server.js",
  "scripts": {
    "start": "concurrently \"npm run start:admin\" \"npm run start:client\" \"npm run start:llm\" \"npm run start:auth\"",
    "start:admin": "node admin-service/server.js",
    "start:client": "node client-service/server.js",
    "start:llm": "node llm-service/index.js",
    "start:auth": "node user-authentication/server.js",
    "db:init": "node admin-service/setup.js",
    "db:clean": "node admin-service/clean.js",
    "db:reset": "npm run db:clean && npm run db:init",
    "pretest": "node tests/clean-test-results.js && npm run db:reset",
    "test": "jest",
    "test:backend": "jest backend/tests --watchAll",
    "test:llm": "jest llm-service/tests --watchAll"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "reporters": [
      "default",
      "<rootDir>/tests/CustomReporter.js"
    ],
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"]
  }
}
